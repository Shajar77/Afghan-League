# APL Environment Configuration Template
# Duplicate this file as .env or configure these variables in Vercel Project Settings

# Site Variant: 'main' or 'variant'
VITE_SITE_VARIANT=main

# Base API URL (Staging or Production endpoint)
VITE_API_URL=https://api-staging.chaptersquare.com/api/v1

# Admin credentials used for the public registration upload flow (image uploads require auth).
# Set these in Vercel Project Settings — never hardcode in source code.
VITE_ADMIN_EMAIL=your_admin_email_here
VITE_ADMIN_PASSWORD=your_admin_password_here

# Google reCAPTCHA v2 / v3 Site Key
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Set to 'true' to open player registration to the public, 'false' to close it
VITE_REGISTRATION_OPEN=false
